{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "ignoreDeprecations": "6.0",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": ".",
    "outDir": "./dist",
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "app.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}